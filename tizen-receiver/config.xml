<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://jacarew.github.io/jcrw-caption/tizen-receiver"
        version="0.1.0" viewmodes="maximized">
    <tizen:application id="JCRWCaption.TizenReceiver" package="JCRWCaption" required_version="2.4"/>
    <content src="index.html"/>
    <name>Jcrw Tizen Alıcısı</name>
    <icon src="icon.png"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <access origin="*" subdomains="true"/>
</widget>
